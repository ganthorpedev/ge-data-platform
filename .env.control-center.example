# GE Data Control Center -- host-side CLI settings for the LOCAL Compose stack.
# Copy to .env.control-center (git-ignored). Process environment variables win.
# The legacy .env (telemetry/production POSTGRES_* settings) is never read by gecc.
GECC_ENVIRONMENT=local
GECC_CONTROL_DB_URL=postgresql+psycopg2://gecc_admin:gecc_admin_dev@127.0.0.1:55432/ge_control
GECC_WAREHOUSE_DB_URL=postgresql+psycopg2://ge_wh_admin:ge_wh_admin_dev@127.0.0.1:55433/ge_warehouse
GECC_API_TOKEN=gecc-local-dev-token
GECC_LEASE_SECONDS=30
GECC_HEARTBEAT_SECONDS=5
