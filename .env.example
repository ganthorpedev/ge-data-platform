# Canonical configuration file
#
# Copy this file to <project-root>/.env. Process environment variables have
# highest precedence, followed by this canonical file, then a legacy .env in
# the current working directory. Legacy nested files are temporary and log a
# migration warning. Never put real credentials in this example.

# PostgreSQL (one server instance, shared credentials, two database names)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_DB is the legacy database (Settings/PostgresLoader) -- still
# telemetry_warehouse; unchanged by the ge_warehouse platform work.
POSTGRES_DB=telemetry_warehouse
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_TIMEOUT_SECONDS=30
# GE_WAREHOUSE_DB is the new platform database (PlatformSettings). Separate
# setting on purpose so neither name is hardcoded in new platform code -- see
# docs/ge_warehouse_architecture.md.
GE_WAREHOUSE_DB=ge_warehouse

# Shared bounded network retry policy (maximum attempts includes the first)
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=2
HTTP_CONNECT_TIMEOUT_SECONDS=30
HTTP_READ_TIMEOUT_SECONDS=120

# Sendem / MiX
INSIGHTS_API_URL=https://insights.za.mixtelematics.com
SENDEM_API_KEY=
SENDEM_GROUP_ID=
SYNC_LOOKBACK_DAYS=7

# EzyTrack / Telematics Guru
TELEMATICS_AUTH_URL=
TELEMATICS_GRAPHQL_URL=
TELEMATICS_USERNAME=
TELEMATICS_PASSWORD=
TELEMATICS_GRANT_TYPE=password
TELEMATICS_ORGANISATION_ID=
TELEMATICS_LOOKBACK_DAYS=7
TELEMATICS_PAGE_SIZE=50
TELEMATICS_LOOKBACK_HOURS=6
TELEMATICS_CHUNK_HOURS=1
EZYTRACK_MAX_CATCHUP_HOURS=168
EZYTRACK_CATCHUP_OVERLAP_MINUTES=30
EZYTRACK_MAX_PAGES=500
EZYTRACK_RECONCILIATION_LOOKBACK_HOURS=48

# Trackunit / AEMP
TRACKUNIT_TOKEN_URL=https://auth.trackunit.com/token
TRACKUNIT_ASSET_BASE_URL=https://iris.trackunit.com/api/asset
TRACKUNIT_AEMP_BASE_URL=https://iris.trackunit.com/public/api/aemp/v2
TRACKUNIT_SITE_BASE_URL=https://iris.trackunit.com/api/site/v1
TRACKUNIT_CLIENT_ID=
TRACKUNIT_CLIENT_SECRET=
TRACKUNIT_USERNAME=
TRACKUNIT_PASSWORD=
TRACKUNIT_SCOPE=api
TRACKUNIT_ACCOUNT_ID=
TRACKUNIT_TIMEZONE=Africa/Harare
TRACKUNIT_REQUEST_DELAY_SECONDS=1
TRACKUNIT_MAX_RETRIES=7
TRACKUNIT_RATE_LIMIT_BASE_DELAY_SECONDS=30
TRACKUNIT_RATE_LIMIT_MAX_DELAY_SECONDS=300

# Stale-run cleanup and bounded post-load validation
ETL_ABANDONED_RUN_HOURS=12
ETL_VALIDATION_MODE=warn
ETL_VALIDATION_LOOKBACK_HOURS=24

# Accounts / Evolution (GE + TLS share one SQL Server instance and one
# read-only login; only the database name differs per company)
EVOLUTION_SQL_DRIVER=ODBC Driver 17 for SQL Server
EVOLUTION_SQL_SERVER=
EVOLUTION_SQL_USERNAME=
EVOLUTION_SQL_PASSWORD=
EVOLUTION_GE_DATABASE=
EVOLUTION_TLS_DATABASE=
EVOLUTION_PROJECT_REPORTS_VIEW=dbo.vwProjectsReports
EVOLUTION_SQL_CONNECT_TIMEOUT_SECONDS=30

# Dagster subprocess limits
SENDEM_JOB_TIMEOUT_MINUTES=60
EZYTRACK_JOB_TIMEOUT_MINUTES=60
TRACKUNIT_JOB_TIMEOUT_MINUTES=360
ACCOUNTS_EVOLUTION_PROJECT_REPORTS_JOB_TIMEOUT_MINUTES=60
ETL_SUBPROCESS_TERMINATE_GRACE_SECONDS=10

# Operational alerts and freshness
TELEMETRY_ALERTS_ENABLED=false
TELEMETRY_ALERT_WEBHOOK_URL=
TELEMETRY_ALERT_COOLDOWN_MINUTES=360
SENDEM_MAX_SUCCESS_AGE_HOURS=12
EZYTRACK_MAX_SUCCESS_AGE_HOURS=12
TRACKUNIT_MAX_SUCCESS_AGE_HOURS=30
